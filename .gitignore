# ==========================================
# General & OS
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# ==========================================
# Logs & Environment Variables
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Archivos de entorno (nunca subir credenciales)
.env
.env*.local
!.env.example
!.env.template

# ==========================================
# Node.js / JavaScript / TypeScript
# ==========================================
node_modules/
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Build outputs
dist/
out/
build/
*.tsbuildinfo

# ==========================================
# Next.js
# ==========================================
.next/
coverage/
.vercel

# ==========================================
# Go (Golang)
# ==========================================
# Binarios compilados
*.exe
*.exe-
*.dll
*.so
*.dylib

# Salidas de compilación de Go
/bin/
/main
*.test
*.out

# Cobertura de tests
*.cover
*.mo

# ==========================================
# Prisma
# ==========================================
# Base de datos SQLite local (si se usa para dev local)
/prisma/*.db
/prisma/*.db-journal

# Nota: El cliente generado (node_modules/@prisma/client) 
# ya se ignora automáticamente por node_modules/

# ==========================================
# Devcontainers & IDEs
# ==========================================
# Devcontainers (Normalmente se incluye el dir en git, pero
# ignoramos datos temporales de la extensión)
.devcontainer/container-data/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / GoLand / WebStorm
.idea/
*.iml

# ==========================================

# ==========================================
# moonrepo & proto
# ==========================================
# Caché local de moon (artefactos de builds, hashes, estados de tareas)
.moon/cache/

# Binarios descargados localmente por proto (Node, Go, pnpm, etc.)
.proto/